[Unit]
Description=Build Ways Duel Club multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/roulette-club/current
Environment=NODE_ENV=production
Environment=PORT=8787
ExecStart=/usr/bin/node /opt/roulette-club/current/server.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
